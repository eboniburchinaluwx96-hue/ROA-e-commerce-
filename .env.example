# ============================================
# ENVIRONMENT CONFIGURATION
# ============================================
NODE_ENV=development

# ============================================
# DATABASE CONFIGURATION (AWS RDS)
# ============================================
# If hosted on AWS Elastic Beanstalk, use RDS environment variables
# Otherwise, specify your own PostgreSQL credentials

# Using AWS RDS (Elastic Beanstalk will inject these automatically)
DB_HOST=your-rds-instance.c9akciq32.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=roa
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_SSL=true

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=5000
API_URL=http://localhost:5000
API_URL_PROD=https://your-domain.com

# ============================================
# AWS CONFIGURATION
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# S3 Configuration
AWS_S3_BUCKET=roa-ecommerce-bucket
AWS_S3_BUCKET_REGION=us-east-1
AWS_S3_IMAGE_FOLDER=products
AWS_S3_AVATAR_FOLDER=avatars

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key
JWT_REFRESH_EXPIRE=30d

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
MAIL_SERVICE=gmail
MAIL_USER=your-email@gmail.com
MAIL_PASSWORD=your_app_password

# ============================================
# SMS/NOTIFICATION CONFIGURATION (Optional)
# ============================================
TERMII_API_KEY=your_termii_api_key
SMS_FROM=YourBrandName

# ============================================
# PAYMENT GATEWAY CONFIGURATION (Optional - Phase 2)
# ============================================
PAYSTACK_SECRET_KEY=your_paystack_secret_key
FLUTTERWAVE_SECRET_KEY=your_flutterwave_secret_key

# ============================================
# CORS CONFIGURATION
# ============================================
CORS_ORIGIN=http://localhost:3000,https://your-domain.com
